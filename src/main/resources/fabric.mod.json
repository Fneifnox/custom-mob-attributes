{
	"schemaVersion": 1,
	"id": "custom-mob-attributes",
	"version": "${version}",
	"name": "Custom Mob Attributes",
	"description": "This mod lets you configure the attributes of vanilla and modded mobs. You can change their health, attack damage, movement speed and scale.",
	"authors": [
		"Fneifnox"
	],
	"contact": {
		"homepage": "https://discord.gg/bszSDCq5ms",
		"sources": "https://github.com/Fneifnox/custom-mob-attributes",
		"issues": "https://github.com/Fneifnox/custom-mob-attributes/issues"
	},
	"license": "Fneifnox's License",
	"icon": "assets/custom-mob-attributes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.fneifnox.custommobattributes.CustomMobAttributes"
		],
		"fabric-datagen": [
			"net.fneifnox.custommobattributes.CustomMobAttributesDataGenerator"
		]
	},
	"mixins": [
		"custom-mob-attributes.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": ">=1.21.2 <1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}